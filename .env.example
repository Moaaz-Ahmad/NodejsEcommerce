# copy to .env
# MongoDB connection string (local server or Atlas), including the database name
MONGODB_URI=mongodb://127.0.0.1:27017/node-complete
# first-run password for the built-in admin account (default: admin123)
ADMIN_PASSWORD=
# REQUIRED secret for hashing usernames (random string; changing it later locks everyone out):
#   node -p "require('crypto').randomBytes(32).toString('hex')"
USERNAME_PEPPER=
# username of the admin account: whoever logs in with it is admin (default: admin)
ADMIN_USERNAME=
# optional: secret for signing session cookies (default: derived from USERNAME_PEPPER; changing it logs everyone out)
SESSION_SECRET=
# optional: how many days "Keep me signed in" lasts (default: 30)
SESSION_DAYS=
# optional: set true once the site is served over HTTPS, so the session cookie is HTTPS-only
COOKIE_SECURE=
# optional: set true when a reverse proxy ends HTTPS in front of the app
TRUST_PROXY=
