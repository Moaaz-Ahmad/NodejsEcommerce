# copy to .env
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=node-complete
# first-run passwords for the built-in admin/user logins (defaults: admin123 / user123)
ADMIN_PASSWORD=
USER_PASSWORD=
# REQUIRED secret for hashing usernames (random string; changing it later locks everyone out):
#   node -p "require('crypto').randomBytes(32).toString('hex')"
USERNAME_PEPPER=
