# copy to .env
# MongoDB connection string (local server or Atlas), including the database name
MONGODB_URI=mongodb://127.0.0.1:27017/node-complete
# first-run password for the built-in admin account (default: admin123)
ADMIN_PASSWORD=
# REQUIRED: secret that signs the session cookie and encrypts stored sessions. Keep it the same between starts
# (changing it signs everyone out). Generate one with:
#   node -p "require('crypto').randomBytes(32).toString('hex')"
SESSION_SECRET=
# email address of the admin account: whoever signs in with it is admin (default: admin@example.com)
ADMIN_EMAIL=
# optional: how many days "Keep me signed in" lasts (default: 30)
SESSION_DAYS=
# optional: set true once the site is served over HTTPS, so the session cookie is HTTPS-only
COOKIE_SECURE=
# optional: set true when a reverse proxy ends HTTPS in front of the app. Also needed for the rate limits and the
# Origin check to see the real client address and host
TRUST_PROXY=
# optional: set to off to disable the request limits (load testing only; leave unset otherwise)
RATE_LIMIT=
