# copy to .env
# MongoDB connection string (local server or Atlas), including the database name
MONGODB_URI=mongodb://127.0.0.1:27017/node-complete
# first-run password for the built-in admin account (default: admin123)
ADMIN_PASSWORD=
# REQUIRED secret for hashing usernames (random string; changing it later locks everyone out):
#   node -p "require('crypto').randomBytes(32).toString('hex')"
USERNAME_PEPPER=
# username of the admin account: whoever logs in with it is admin (default: admin)
ADMIN_USERNAME=
