<%# Shop page: product grid with Details and Add to Cart buttons. %>
<%- include('../partials/head') %>
  <h1 class="md-title">Shop</h1>
  <% if (products.length) { %>
    <div class="product-grid">
      <% products.forEach(p => { %>
        <article class="md-card">
          <%- include('../partials/image', { src: p.imageUrl, alt: p.title, cls: 'md-card__media' }) %>
          <div class="md-card__content">
            <h2 class="md-card__title"><%= p.title %></h2>
            <p class="md-card__price">$<%= p.price.toFixed(2) %></p>
            <div class="md-card__actions">
              <a class="md-button-outlined" href="/products/<%= p.id %>">Details</a>
              <form class="md-inline-form" method="POST" action="/cart">
                <%- include('../partials/csrf') %>
                <input type="hidden" name="productId" value="<%= p.id %>">
                <button class="md-button-filled">Add to Cart</button>
              </form>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state"><h1>No products yet</h1></div>
  <% } %>
<%- include('../partials/foot') %>
