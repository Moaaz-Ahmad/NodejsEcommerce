<%# Change-password form. %>
<%- include('../partials/head') %>
  <% if (error) { %><p class="md-alert" role="alert"><%= error %></p><% } %>
  <form class="md-form" method="POST" action="/change-password">
    <h1 class="md-title">Change Password</h1>
    <div class="md-field">
      <label for="current">Current password</label>
      <input id="current" name="current" type="password" autocomplete="current-password" required autofocus>
    </div>
    <div class="md-field">
      <label for="password">New password (8+ characters)</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required>
    </div>
    <div class="md-field">
      <label for="confirm">Confirm new password</label>
      <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="8" maxlength="128" required>
    </div>
    <button class="md-button-filled">Change password</button>
  </form>
<%- include('../partials/foot') %>
