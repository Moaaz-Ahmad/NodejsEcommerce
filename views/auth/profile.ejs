<%# Profile page: the account email and role, a link to change the password, and order history. %>
<%- include('../partials/head') %>
  <h1 class="md-title">Profile</h1>
  <div class="profile-card">
    <strong><%= user.email %></strong>
    <span><%= user.role %></span>
  </div>
  <p class="section-gap"><a class="md-button-outlined" href="/change-password">Change password</a></p>
  <h2 class="md-subtitle">Order history</h2>
  <% if (orders.length) { %>
    <% orders.forEach(o => { %>
      <section class="order-card">
        <p class="md-muted"><%= new Date(o.placedAt).toLocaleString() %></p>
        <ul>
          <% o.items.forEach(i => { %>
            <li><%= i.title %> &times; <%= i.qty %> &mdash; $<%= (i.price * i.qty).toFixed(2) %></li>
          <% }) %>
        </ul>
        <strong class="md-card__price">Total: $<%= o.total.toFixed(2) %></strong>
      </section>
    <% }) %>
  <% } else { %>
    <p class="md-muted">No orders yet.</p>
  <% } %>
<%- include('../partials/foot') %>
