<%- include('../partials/head') %>
  <% if (error) { %><p class="md-alert" role="alert"><%= error %></p><% } %>
  <form class="md-form" method="POST" action="/login">
    <h1 class="md-title">Login</h1>
    <div class="md-field">
      <label for="username">Username (admin or user)</label>
      <input id="username" name="username" required autofocus>
    </div>
    <div class="md-field">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" required>
    </div>
    <button class="md-button-filled">Login</button>
  </form>
<%- include('../partials/foot') %>
