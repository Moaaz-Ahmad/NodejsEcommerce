<%# Registration form. %>
<%- include('../partials/head') %>
  <% if (error) { %><p class="md-alert" role="alert"><%= error %></p><% } %>
  <form class="md-form" method="POST" action="/register">
    <%- include('../partials/csrf') %>
    <h1 class="md-title">Create account</h1>
    <div class="md-field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" value="<%= email %>" autocomplete="email" maxlength="254" required autofocus>
    </div>
    <div class="md-field">
      <label for="password">Password (8+ characters)</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required>
    </div>
    <div class="md-field">
      <label for="confirm">Confirm password</label>
      <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="8" maxlength="128" required>
    </div>
    <button class="md-button-filled">Register</button>
    <p class="md-muted">Already registered? <a href="/login">Log in</a></p>
  </form>
<%- include('../partials/foot') %>
