<%# Admin product list with Edit and Delete for each product. %>
<%- include('../partials/head') %>
  <h1 class="md-title">Manage Products</h1>
  <p><a class="md-button-filled" href="/admin/add-product">Add Product</a></p>
  <% if (products.length) { %>
    <div class="cart-items-list section-gap">
      <% products.forEach(p => { %>
        <div class="cart-item">
          <%- include('../partials/image', { src: p.imageUrl, alt: '', cls: 'cart-item__image' }) %>
          <div class="cart-item__details">
            <span class="cart-item__title"><%= p.title %></span>
            <span class="cart-item__price">$<%= p.price.toFixed(2) %></span>
          </div>
          <div class="cart-item__actions">
            <a class="md-button-outlined" href="/admin/edit-product/<%= p.id %>">Edit</a>
            <form class="md-inline-form" method="POST" action="/admin/delete-product/<%= p.id %>
              <%- include('../partials/csrf') %>"
                  onsubmit="return confirm('Delete this product?')">
              <button class="md-button-danger">Delete</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state"><h1>No products yet</h1></div>
  <% } %>
<%- include('../partials/foot') %>
