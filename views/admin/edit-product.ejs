<%- include('../partials/head') %>
  <h1><%= product.id ? 'Edit Product' : 'Add Product' %></h1>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="POST" action="<%= product.id ? '/admin/edit-product/' + product.id : '/admin/add-product' %>">
    <input name="title" placeholder="Title" value="<%= product.title || '' %>" required>
    <input name="price" type="number" step="0.01" min="0" placeholder="Price" value="<%= product.price ?? '' %>" required>
    <input name="imageUrl" type="url" placeholder="Image URL (https://…/cover.jpg)" value="<%= product.imageUrl || '' %>">
    <button><%= product.id ? 'Save' : 'Add' %></button>
  </form>
<%- include('../partials/foot') %>
