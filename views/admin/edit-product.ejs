<%# Add or edit product form (the same form, chosen by whether a product id is set). %>
<%- include('../partials/head') %>
  <% if (error) { %><p class="md-alert" role="alert"><%= error %></p><% } %>
  <form class="md-form" method="POST" action="<%= product.id ? '/admin/edit-product/' + product.id : '/admin/add-product' %>">
    <h1 class="md-title"><%= product.id ? 'Edit Product' : 'Add Product' %></h1>
    <div class="md-field">
      <label for="title">Title</label>
      <input id="title" name="title" value="<%= product.title || '' %>" required>
    </div>
    <div class="md-field">
      <label for="price">Price</label>
      <input id="price" name="price" type="number" step="0.01" min="0" value="<%= product.price ?? '' %>" required>
    </div>
    <div class="md-field">
      <label for="imageUrl">Image URL (optional)</label>
      <input id="imageUrl" name="imageUrl" type="url" placeholder="https://…/cover.jpg" value="<%= product.imageUrl || '' %>">
    </div>
    <button class="md-button-filled"><%= product.id ? 'Save' : 'Add' %></button>
  </form>
<%- include('../partials/foot') %>
