<%# Start of every page: document head, stylesheet links, the header (navigation, cart badge, profile, logout) and the one-off toast message. Opens <main>. %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <header class="md-header">
    <a class="md-header__brand" href="/"><span class="material-symbols-outlined">storefront</span>SimpleCom</a>
    <div class="md-header__actions">
      <% if (user) { %>
        <% if (user.role === 'admin') { %>
          <a class="md-button-text" href="/admin/products">Manage Products</a>
          <a class="md-button-text" href="/admin/add-product">Add Product</a>
        <% } %>
        <a class="md-icon-button" href="/cart" title="Cart" aria-label="Cart">
          <span class="material-symbols-outlined">shopping_cart</span>
          <% if (cartCount) { %><span class="md-badge"><%= cartCount %></span><% } %>
        </a>
        <a class="md-icon-button" href="/profile" title="Profile" aria-label="Profile">
          <span class="material-symbols-outlined">person</span>
        </a>
        <span class="md-header__user"><%= user.email %> (<%= user.role %>)</span>
        <form class="md-inline-form" method="POST" action="/logout">
          <%- include('csrf') %>
          <button class="md-icon-button" title="Logout" aria-label="Logout">
            <span class="material-symbols-outlined">logout</span>
          </button>
        </form>
      <% } else { %>
        <a class="md-button-text" href="/login">Login</a>
        <a class="md-button-text" href="/register">Register</a>
      <% } %>
    </div>
  </header>
  <% if (toast) { %><div class="md-snackbar" role="status"><%= toast %></div><% } %>
  <main class="main-container">
